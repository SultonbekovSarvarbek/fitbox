# Nusxa oling: .env — va qiymatlarni o'zgartiring. .env git'ga qo'shilmaydi.
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string

# Faqat dev: testchilar SMS'siz shu kod bilan kira oladi. Prod'da o'chiring.
OTP_DEV_CODE=111111

# console — SMS konsolga yoziladi; eskiz — haqiqiy SMS.
SMS_PROVIDER=console
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
